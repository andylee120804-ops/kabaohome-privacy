# HarmonyOS
.idea/
.build/
.hvigor/
oh_modules/
entry/build/
entry/.preview/
node_modules/
local.properties

# 签名凭据 — 包含 keyPassword/storePassword，不可提交
build-profile.json5
entry/build-profile.json5

# AGC 配置 — 包含 client_secret/api_key，不可提交
entry/src/main/resources/rawfile/agconnect-services.json

# 签名文件
*.p12
*.p7b
*.cer

# Superpowers brainstorming and worktrees
.superpowers/
.worktrees/

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local

# Code Scanner cache
.codescanner/
.claude/settings.local.json

# AGC cloud function credential (contains plaintext client_secret, never commit)
# 覆盖 cloud/shared/ 及所有函数目录内的 shared/（deploy.cjs 会把凭证复制进各函数包）
cloud/shared/agc-credential.json
cloud/*/shared/agc-credential.json

# AGC API Client credential (contains plaintext client_secret, never commit)
cloud/shared/agc-apiclient-*.json
cloud/*/shared/agc-apiclient-*.json

# AGC Service Account credential (contains private key, never commit)
cloud/shared/agc-service-account*.json
cloud/*/shared/agc-service-account*.json

# DevEco 性能分析器调试产物（含数百 MB 的 htrace/perfdata/视频，禁止提交）
.appanalyzer/

# 签名凭据备份 — 同 build-profile.json5，含密钥，禁止提交
build-profile.json5.bak

# AI 工具本地目录（会话状态/缓存，非项目源码）
.codebuddy/
.codegenie/
.codex/
.cursor/
.arts/
.mcp.json
.npmrc
.ohpmrc

# 临时/分析产物
hs_err_pid*.log
*.xlsx
contrast_*.py
result*.xlsx
