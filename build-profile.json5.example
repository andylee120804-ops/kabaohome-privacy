{
  "app": {
    "signingConfigs": [
      {
        "name": "kabao",
        "type": "HarmonyOS",
        "material": {
          "certpath": "PATH_TO_CERT.cer",
          "keyAlias": "YOUR_KEY_ALIAS",
          "keyPassword": "ENCRYPTED_KEY_PASSWORD",
          "profile": "PATH_TO_PROFILE.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "PATH_TO_KEYSTORE.p12",
          "storePassword": "ENCRYPTED_STORE_PASSWORD"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "kabao",
        "targetSdkVersion": "6.1.0(23)",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "capabilities": [
      {
        "bundleName": "com.family.kabaohome",
        "config": [
          { "name": "Map Kit", "capability": "com.huawei.service.mapkit" },
          { "name": "Cloud DB", "capability": "com.huawei.service.clouddb" },
          { "name": "Cloud Function", "capability": "com.huawei.service.cloudfunction" },
          { "name": "Cloud Storage", "capability": "com.huawei.service.cloudstorage" },
          { "name": "Auth Service", "capability": "com.huawei.service.auth" }
        ]
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": ["default"]
        }
      ]
    }
  ]
}
