{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/scripts/git-guard.cjs\"",
            "description": "阻止在脏工作区执行 git reset --hard / clean -fdx / checkout . 等破坏性命令(2026-09-08 事故防护)"
          }
        ]
      }
    ]
  }
}
